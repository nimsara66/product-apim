<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Integration Tests v2" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="org.wso2.am.integration.cucumbertests.utils.listeners.BlockLifecycleListener"/>
        <listener class-name="org.wso2.am.integration.cucumbertests.utils.listeners.BlockScopeListener"/>
        <listener class-name="org.wso2.am.integration.cucumbertests.utils.listeners.CoverageAggregationListener"/>
    </listeners>
    <!-- Keep GovernanceComplianceBlockingRunner last and sequential: its temporary global BLOCK policy can reject
         sibling API deployments if cleanup fails. -->
    <test name="IntegrationV2-LoggingAndElkAnalytics" parallel="classes" thread-count="1">
        <parameter name="blockLabel" value="logging-elk-analytics"/>
        <parameter name="apimCpuLimit" value="1"/>
        <parameter name="initTenantUsers" value="true"/>
        <parameter name="initBackend" value="true"/>
        <parameter name="initProxy" value="true"/>
        <parameter name="tomlExtraOverlayPath" value="src/test/resources/artifacts/configFiles/loggingElkAnalytics/deployment.toml"/>
        <classes>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.AnalyticsElkMetricsRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.AnalyticsCorrelationLoggingRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.AnalyticsPerApiLoggingRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.GatewayWebSocketProxyAnonRoutingRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.NetworkAccessControlTenantConfRunner"/>
        </classes>
    </test>
    <test name="IntegrationV2-ApprovalWorkflow" parallel="classes" thread-count="1">
        <parameter name="blockLabel" value="approval-workflow"/>
        <parameter name="apimCpuLimit" value="1"/>
        <parameter name="initTenantUsers" value="true"/>
        <parameter name="initBackend" value="true"/>
        <parameter name="initProxy" value="true"/>
        <parameter name="tomlExtraOverlayPath" value="src/test/resources/artifacts/configFiles/approveWorkflowAllInOne/deployment.toml"/>
        <parameter name="serverFilesToCopy" value="src/test/resources/artifacts/configFiles/workflowHTTPRedirect/SubscriptionCreationCustomWorkflowExecutor-1.0.0.jar::repository/components/lib/SubscriptionCreationCustomWorkflowExecutor-1.0.0.jar"/>
        <classes>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.WorkflowApprovalRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.WorkflowWsApiStateChangeRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.SubscriptionWorkflowRedirectRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.GatewayWebSocketProxyAuthRoutingRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.NetworkAccessControlAllowRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.NetworkAccessControlUrlAllowRunner"/>
        </classes>
    </test>
    <test name="IntegrationV2-MandatoryPropertiesAndDisplayDeprecated" parallel="classes" thread-count="1">
        <parameter name="blockLabel" value="mandatory-properties-display-deprecated"/>
        <parameter name="apimCpuLimit" value="1"/>
        <parameter name="initTenantUsers" value="true"/>
        <parameter name="tomlExtraOverlayPath" value="src/test/resources/artifacts/configFiles/mandatoryPropertiesDisplayDeprecated/deployment.toml"/>
        <classes>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.PublisherMandatoryPropertiesRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.DevPortalDeprecatedApiDiscoverabilityRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.NetworkAccessControlUrlTenantAllowRunner"/>
        </classes>
    </test>
    <test name="IntegrationV2-SandboxAndTokenExchangeDisabled" parallel="classes" thread-count="2">
        <parameter name="blockLabel" value="sandbox-tx-disabled"/>
        <parameter name="apimCpuLimit" value="1"/>
        <parameter name="initTenantUsers" value="true"/>
        <parameter name="initBackend" value="true"/>
        <parameter name="tomlExtraOverlayPath" value="src/test/resources/artifacts/configFiles/sandboxTxDisabled/deployment.toml"/>
        <classes>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.GatewaySandboxEnvRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.TokenExchangeDisabledRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.NetworkAccessControlUrlDisabledRunner"/>
        </classes>
    </test>
</suite>
