<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Phase 6 (T6.3) smoke: a single publisher runner using the SAME block config as testng-v2.xml's
  IntegrationV2-Publisher block, run against the distributed lane (-Dapim.topology=distributed). Proves the
  BlockLifecycleListener selector + gateway-webapp poll fix drive a real product runner (publish -> deploy ->
  waitForAPIDeployment sync to the GW node) end-to-end. The full publisher block / full testng-v2.xml is
  Phase 7. Uses the same listeners as testng-v2.xml, so nothing in that file changes.
-->
<suite name="Integration Tests v2 (distributed smoke)" parallel="tests" thread-count="1">
    <listeners>
        <listener class-name="org.wso2.am.integration.cucumbertests.utils.listeners.BlockLifecycleListener"/>
        <listener class-name="org.wso2.am.integration.cucumbertests.utils.listeners.BlockScopeListener"/>
    </listeners>
    <test name="IntegrationV2-Publisher" parallel="classes" thread-count="1">
        <parameter name="blockLabel" value="publisher"/>
        <parameter name="initTenantUsers" value="true"/>
        <classes>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.PublisherVersioningRunner"/>
        </classes>
    </test>
</suite>
