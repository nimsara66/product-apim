<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Focused all-in-one runtime lane for ELK invocation analytics events. -->
<suite name="IntegrationV2-Analytics-Invocation-Stats" parallel="false">
    <listeners>
        <listener class-name="org.wso2.am.integration.cucumbertests.utils.listeners.BlockLifecycleListener"/>
        <listener class-name="org.wso2.am.integration.cucumbertests.utils.listeners.BlockScopeListener"/>
        <listener class-name="org.wso2.am.integration.cucumbertests.utils.listeners.CoverageAggregationListener"/>
    </listeners>
    <test name="IntegrationV2-Analytics-Invocation-Stats" parallel="classes" thread-count="1">
        <parameter name="blockLabel" value="analytics-invocation-stats-focused"/>
        <parameter name="initTenantUsers" value="true"/>
        <parameter name="initBackend" value="true"/>
        <parameter name="tomlExtraOverlayPath" value="src/test/resources/artifacts/configFiles/elkAnalytics/deployment.toml"/>
        <classes>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.AnalyticsElkMetricsRunner"/>
        </classes>
    </test>
</suite>
